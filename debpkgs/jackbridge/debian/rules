#!/usr/bin/make -f
export DH_VERBOSE=1

PKG=jackbridge
JACKROUTER_SRC_DIR=$(CURDIR)/../jackbridge-src
LIBEXEC_DIR=$(CURDIR)/debian/$(PKG)/usr/local/libexec/jackbridge

%:
	dh $@

override_dh_auto_configure:
	# Clone the pistomp-companion source if not already present
	if [ ! -d "$(JACKROUTER_SRC_DIR)" ]; then \
		git clone --branch "$(JACKROUTER_REF)" --depth 1 \
			"$(JACKROUTER_REPO)" \
			"$(JACKROUTER_SRC_DIR)"; \
	fi

override_dh_auto_build:
	# No compilation — all scripts are shell.

override_dh_auto_install:
	# The helpers this image wants. Listed explicitly, not globbed: pistomp-companion
	# is upstream and may carry scripts pi-Stomp has no use for, and choosing what
	# lands on the image is this package's job. Adding one upstream does not
	# install it here until it is named below.
	install -d "$(LIBEXEC_DIR)"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-pi-up"        "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-pi-down"      "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-xrun-watcher" "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-pi-status"    "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jb-detect-net-iface"     "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-pin-route"    "$(LIBEXEC_DIR)/"
	install -Dm 755 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/bin/jackbridge-unpin-route"  "$(LIBEXEC_DIR)/"
	# Unit file, from the same upstream checkout as the scripts above. It used
	# to be a second copy under debian/, which drifted from pistomp-companion's
	# and won because the .deb is what lands on hardware. One source only.
	install -Dm 644 "$(JACKROUTER_SRC_DIR)/jackbridge/pi/pi-stomp-jackbridge.service" \
		$(CURDIR)/debian/jackbridge/lib/systemd/system/pi-stomp-jackbridge.service

override_dh_usrlocal:
	# We intentionally install helper scripts under /usr/local/libexec/jackbridge/.
	# dh_usrlocal expects only directories under /usr/local, so skip it.

override_dh_installsystemd:
	# No auto-enable; the Mac drives start/stop. No [Install] section either,
	# so deb-systemd-helper would be a no-op anyway.