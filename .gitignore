deploy/*
work/*
postrun.sh
SKIP
SKIP_IMAGES
.pc
*-pc

# Built .deb cache (populated by debpkgs/*/build.sh and build-rt-kernel-docker.sh)
cache/

# Local .deb overrides (populated by build-package-docker.sh) — installed by
# the next image build in preference to the published apt repo
overrides/

# Binary-only .deb staging trees (created by build.sh, not source): the
# debpkgs/<pkg>/debian/<pkg>/ subdir named after the package, which build.sh
# rm -rf's and regenerates. Ignore every directory under debian/ and re-include
# the three that are real source
debpkgs/*/debian/*/
!debpkgs/*/debian/patches/
!debpkgs/*/debian/source/
!debpkgs/*/debian/extra/

# Generated by gen-font-h.py during build
debpkgs/lcd-splash/src/font.h

# Generated Imager manifest (produced by generate-imager-manifest.sh)
# Lives in repo root for local file:// testing; pushed to gh-pages, not main
pistomp-imager-manifest.json

__pycache__/
*.pyc

.vscode/settings.json
